PORT=4000
HOST=127.0.0.1
# AI_PROVIDER=ollama uses the local Ollama server; no API key is needed.
AI_PROVIDER=ollama
# Project-managed Ollama (npm run dev/start), with bounded host prompt cache.
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3-vl:8b-instruct-q8_0
# Optional paths; defaults use .venv-vision and .reference/vision-index.npz.
# VISION_PYTHON=
# VISION_INDEX_PATH=
# Optional alternative: set AI_PROVIDER=gemini and provide a Gemini key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional TTS comparison credentials. Keep real keys in be/.env only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# SQLite uses be/data/ganhmuusinh.sqlite by default.
# DATABASE_PATH=
